# Pipeline Configuration
ENABLE_MEDIA_MOCK=true
TARGET_MASCOT=
LOG_LEVEL=INFO

# DeepSeek API (Script & Metadata Generation)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Segmind API (Video Seedance 2.0 + TTS Narration Generation)
SEGMIND_API_KEY=your_segmind_api_key_here

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=dookie-tv-assets

# Telegram Bot API (Human Approval Gateway)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# YouTube Data API (OAuth2 Publishing)
YOUTUBE_CLIENT_SECRET_FILE=config/client_secret.json
YOUTUBE_CREDENTIALS_FILE=config/youtube_oauth2.json
